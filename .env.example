# ============================================================================
# NUVIAX SAAS - TEMPLATE DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env.local y completa tus valores reales.
# ============================================================================

# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret (Solo accesible en el servidor Next.js)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Branding & Domain Configuration
NEXT_PUBLIC_APP_NAME="Nuviax"
NEXT_PUBLIC_APP_TAGLINE="Invitaciones Digitales Exclusivas"
NEXT_PUBLIC_APP_URL="https://tu-dominio.com"
NEXT_PUBLIC_COMPANY_NAME="RSD SOLUTIONS"

# Payment Gateway Configuration
PAYMENTS_MODE=test
NEXT_PUBLIC_CURRENCY=USD
